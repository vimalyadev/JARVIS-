# ========================================================
# JARVIS PERSONAL ASSISTANT - CONFIGURATION
# ========================================================

# Assistant Settings
JARVIS_NAME=Jarvis
USER_NAME=Sir
WAKE_WORDS=jarvis,hey jarvis,ok jarvis

# Server Settings (Hosts on all interfaces so mobile devices on the same Wi-Fi can connect)
HOST=0.0.0.0
PORT=8000

# AI Engine Model Provider: "gemini", "groq", "openai", "ollama", or "fallback"
AI_PROVIDER=gemini

# API Keys (Provide at least one, or use 'ollama' / 'fallback' for completely offline mode)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Ollama local settings (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Text-to-Speech Settings
# "edge" (Realistic Microsoft Edge neural voice) or "local" (pyttsx3 system voice)
TTS_ENGINE=edge
EDGE_VOICE=en-GB-RyanNeural
SPEECH_RATE=+0%
SPEECH_PITCH=+0Hz
